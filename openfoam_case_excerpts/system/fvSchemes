FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         backward;
}

gradSchemes
{
    default         Gauss linear;
    grad(U)         cellLimited Gauss linear 1.0;
}

divSchemes
{
    div(phi,U)                      Gauss LUST grad(U);
    div((nuEff*dev2(T(grad(U)))))   Gauss linear;
}

laplacianSchemes
{
    default                             Gauss linear corrected;
    laplacian(diffusivity,cellMotionU)  Gauss linear limited 0.25;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{}

